{
  "name": "yedige-batyrkhan-student-api",
  "services": {
    "app": {
      "image": "yedige-batyrkhan-student-api:v1.0-yedige-batyrkhan",
      "build": {
        "context": "/home/batyr/devops/yedige-batyrkhan-student-api",
        "dockerfile": "Dockerfile",
        "args": {
          "APP_VERSION": "1.0.1"
        }
      },
      "ports": [
        {
          "mode": "ingress",
          "host_ip": "127.0.0.1",
          "target": 8080,
          "published": "8081",
          "protocol": "tcp"
        }
      ],
      "networks": {
        "student-network": null
      }
    },
    "db": {
      "image": "postgres:16.15-bookworm@sha256:e8a07d2c7579b038938cdba6c539e580e5001caf9ea203d397b5cc83e76bd938",
      "networks": {
        "student-network": null
      },
      "volumes": [
        {
          "type": "volume",
          "source": "student-data",
          "target": "/var/lib/postgresql/data",
          "volume": {}
        }
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -U $$POSTGRES_USER -d $$POSTGRES_DB"
        ],
        "timeout": "3s",
        "interval": "5s",
        "retries": 20,
        "start_period": "10s"
      }
    }
  },
  "networks": {
    "student-network": {
      "name": "yedige-batyrkhan-student-api_student-network",
      "ipam": {}
    }
  },
  "volumes": {
    "student-data": {
      "name": "yedige-batyrkhan-student-api_student-data"
    }
  }
}
